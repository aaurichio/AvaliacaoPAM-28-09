<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppLibertadoresHAS.Views.Jogadores.ListagemJogadorView"
             Title="Jogadores">
    <CollectionView ItemsSource="{Binding Jogadores}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Margin="8,4" Padding="10" BackgroundColor="LightGray">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               FontSize="28"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Text="{Binding Numero}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label FontSize="18"
                                   FontAttributes="Bold"
                                   Text="{Binding Nome}" />
                            <Label FontSize="12"
                                   Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>